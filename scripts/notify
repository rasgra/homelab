#!/usr/bin/env python3
"""
scripts/notify — Send a Telegram notification.

Standalone usage:
  ./scripts/notify --level critical --title "Disk Alert" --message "text"

Levels: info | warning | critical | ok

Also importable by other scripts:
  sys.path.insert(0, str(Path(__file__).parent))
  from notify import send, Level
"""

import json
import os
import sys
import urllib.request
import urllib.error
from enum import Enum
from pathlib import Path

HOMELAB_DIR = Path(__file__).resolve().parent.parent
HOSTNAME = os.uname().nodename

class Level(Enum):
    OK       = ("ok",       "🟢")
    INFO     = ("info",     "ℹ️")
    WARNING  = ("warning",  "🟡")
    CRITICAL = ("critical", "🔴")
    DIGEST   = ("digest",   "📊")

    def __init__(self, key, emoji):
        self.key   = key
        self.emoji = emoji

    @classmethod
    def from_str(cls, s):
        for m in cls:
            if m.key == s.lower():
                return m
        return cls.INFO


def _load_credentials():
    """Read TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID from .env or environment."""
    config = {}
    env_file = HOMELAB_DIR / ".env"
    if env_file.exists():
        for line in env_file.read_text().splitlines():
            line = line.strip()
            if line.startswith("TELEGRAM_") and "=" in line:
                k, _, v = line.partition("=")
                config[k.strip()] = v.strip().strip('"').strip("'")

    token   = config.get("TELEGRAM_BOT_TOKEN")   or os.environ.get("TELEGRAM_BOT_TOKEN")
    chat_id = config.get("TELEGRAM_CHAT_ID")      or os.environ.get("TELEGRAM_CHAT_ID")
    return token, chat_id


def send(level: Level, title: str, body: str = "", silent: bool = False) -> bool:
    """
    Send a Telegram message. Returns True on success.
    level   : Level enum value
    title   : bold header line
    body    : optional detail lines (plain text, newlines ok)
    silent  : if True, suppress terminal notification sounds
    """
    token, chat_id = _load_credentials()
    if not token or not chat_id:
        print("notify: TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID not set in .env",
              file=sys.stderr)
        return False

    lines = [f"{level.emoji} <b>{title}</b>  <i>({HOSTNAME})</i>"]
    if body:
        # Escape HTML special chars in body
        safe = body.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        lines.append(f"<pre>{safe}</pre>")

    text = "\n".join(lines)

    payload = json.dumps({
        "chat_id":              chat_id,
        "text":                 text,
        "parse_mode":           "HTML",
        "disable_notification": silent,
    }).encode()

    url = f"https://api.telegram.org/bot{token}/sendMessage"
    try:
        req = urllib.request.Request(
            url, data=payload,
            headers={"Content-Type": "application/json"}
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            result = json.loads(resp.read())
            return result.get("ok", False)
    except urllib.error.HTTPError as e:
        print(f"notify: Telegram API error {e.code}: {e.read().decode()}", file=sys.stderr)
    except Exception as e:
        print(f"notify: {e}", file=sys.stderr)
    return False


def main():
    import argparse
    p = argparse.ArgumentParser(description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--level",   default="info",
                   choices=[m.key for m in Level],
                   help="Message severity (default: info)")
    p.add_argument("--title",   required=True, help="Message title (bold)")
    p.add_argument("--message", default="",    help="Message body")
    p.add_argument("--silent",  action="store_true",
                   help="Send without notification sound")
    args = p.parse_args()

    level = Level.from_str(args.level)
    ok = send(level, args.title, args.message, silent=args.silent)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
