# Base domain for internal services (split-horizon DNS, LAN/WG access)
BASE_DOMAIN=stormyra.se

# Public domain for services exposed via Cloudflare Tunnel
PUBLIC_DOMAIN=stormyra.org

# Data directory for all persistent storage
DATA_DIR=/opt/stack

# Services to enable (comma-separated: nextcloud,uisp,jitsi,unifi,cloudflared,finance,training,homeassistant,zigbee2mqtt)
# Caddy always runs as it's the reverse proxy
# cloudflared exposes files.<domain> publicly via Cloudflare Tunnel
# finance runs the household finance dashboard (built from ../finance)
# training runs the Garmin training tracker (built from ../training)
# homeassistant runs Home Assistant for smart-home automation
# zigbee2mqtt runs Mosquitto + Zigbee2MQTT for Sonoff Dongle Max over LAN
COMPOSE_PROFILES=nextcloud,uisp,jitsi,unifi,cloudflared,finance,training,homeassistant,zigbee2mqtt
