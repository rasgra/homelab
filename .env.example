# Base domain for internal services (split-horizon DNS, LAN/WG access)
BASE_DOMAIN=stormyra.se

# Public domain for services exposed via Cloudflare Tunnel
PUBLIC_DOMAIN=stormyra.org

# Data directory for all persistent storage
DATA_DIR=/opt/stack

# Services to enable (comma-separated: nextcloud,uisp,jitsi,unifi)
# Caddy always runs as it's the reverse proxy
COMPOSE_PROFILES=nextcloud,uisp,jitsi,unifi
