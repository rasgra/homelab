{
	email mail@{$BASE_DOMAIN}
	log {
		output stdout
		level INFO
	}
}

# =========================
# Reusable snippets
# =========================

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer"
	}
}

(proxy_headers) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-Port {server_port}
}

# =========================
# Nextcloud
# =========================

nextcloud.{$BASE_DOMAIN} {
	import security_headers

	reverse_proxy nextcloud:80 {
		import proxy_headers
	}
}

# =========================
# UISP
# =========================

uisp.{$BASE_DOMAIN} {
	import security_headers

	# Admin UI – restricted to management subnet
	@admin path /nms* /nms/*
	@wg remote_ip {$MGMT_ALLOWED_SUBNET}

	handle @admin {
		handle @wg {
			reverse_proxy uisp:443 {
				transport http {
					tls_insecure_skip_verify
				}
				import proxy_headers
			}
		}
		respond "Admin access requires VPN" 403
	}

	# Public-facing UISP endpoints
	handle {
		reverse_proxy uisp:443 {
			transport http {
				tls_insecure_skip_verify
			}
			import proxy_headers
		}
	}
}

# =========================
# UniFi Controller
# =========================

unifi.{$BASE_DOMAIN} {
	tls internal
	import security_headers

	@wg remote_ip {$MGMT_ALLOWED_SUBNET}
	handle @wg {
		reverse_proxy unifi:8443 {
			transport http {
				tls_insecure_skip_verify
			}
			import proxy_headers
		}
	}

	respond "UniFi GUI requires VPN" 403
}

# =========================
# Jitsi Meet
# =========================

meet.{$BASE_DOMAIN} {
	reverse_proxy web:80 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 443
	}
}

